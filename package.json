{
    "name": "node-api",
    "version": "2.0.0",
    "description": "REST API with social login (Facebook, Google), user profiles and nearby-user search",
    "main": "index.js",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch --env-file-if-exists=.env index.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "audit:prod": "npm audit --omit=dev --audit-level=high",
        "migrate:status": "migrate-mongo status",
        "migrate:up": "migrate-mongo up",
        "migrate:down": "migrate-mongo down",
        "db:find-duplicates": "node scripts/find-duplicate-users.js",
        "db:seed": "node scripts/seed.js",
        "loadtest": "node scripts/loadtest.js"
    },
    "author": "Tulsi Ram Maurya",
    "license": "ISC",
    "dependencies": {
        "config": "^4.4.2",
        "cors": "^2.8.6",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.3",
        "google-auth-library": "^11.3.3",
        "helmet": "^8.3.0",
        "joi": "^18.3.2",
        "jsonwebtoken": "^9.0.3",
        "migrate-mongo": "^14.0.7",
        "mongoose": "^9.12.0",
        "winston": "^3.19.0",
        "winston-mongodb": "^7.0.1"
    },
    "jest": {
        "testEnvironment": "node",
        "testTimeout": 30000,
        "collectCoverageFrom": [
            "api/**/*.js",
            "lib/**/*.js",
            "middleware/**/*.js",
            "startup/**/*.js",
            "app.js"
        ],
        "coverageThreshold": {
            "global": {
                "statements": 92,
                "branches": 80,
                "functions": 94,
                "lines": 95
            }
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "jest": "^30.5.2",
        "mongodb-memory-server": "^11.3.0",
        "supertest": "^7.3.1"
    }
}
