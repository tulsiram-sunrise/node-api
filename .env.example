# Copy to .env for local development (`npm run dev` loads it automatically).
# Never commit real values.

NODE_ENV=development
PORT=5000
# Public base URL of this API (used in links the API returns, e.g. the Facebook
# data-deletion status URL). Empty = derived from the request.
napi_publicUrl=
napi_db=mongodb://127.0.0.1:27017/nodeapi

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
napi_JWTPrivateKey=
napi_jwtExpiresIn=1d

# Social login (each provider is optional; unconfigured providers return 501)
napi_FacebookClientId=
napi_FacebookClientSecret=
# Comma-separated list allowed for web/iOS/Android client IDs
napi_GoogleClientId=

# JSON array of allowed browser origins, e.g. ["https://app.example.com"]
napi_corsOrigins=[]
# Number of reverse proxies in front of the app (e.g. 1 behind a load balancer)
napi_trustProxy=false

napi_logLevel=info
napi_logFile=
napi_logDb=
